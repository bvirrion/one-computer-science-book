; euclid_asm.toy -- the gcd of 252 and 198 by subtraction (no division here)
        LOADI R0, 252
        LOADI R1, 198
loop:   CMP   R0, R1
        JZ    done          ; equal: that is the gcd
        JC    swap          ; R0 < R1: exchange them first
        SUB   R0, R1        ; R0 = R0 - R1
        JMP   loop
swap:   PUSH  R0
        PUSH  R1
        POP   R0
        POP   R1
        JMP   loop
done:   OUT   R0
        HALT
