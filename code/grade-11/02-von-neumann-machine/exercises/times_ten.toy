; times_ten.toy -- exercise 11: reads x, prints 10x as 8x + 2x, with shifts
        IN    R0
        SHL   R0            ; R0 = 2x
        LOADI R1, 0
        ADD   R1, R0        ; R1 = 2x
        SHL   R0
        SHL   R0            ; R0 = 8x
        ADD   R0, R1        ; 8x + 2x
        OUT   R0
        HALT
