; gcd.toy -- exercise 15: while a != b: subtract the smaller from the larger
        IN    R0            ; a
        IN    R1            ; b
loop:   CMP   R0, R1
        JZ    done          ; a == b
        JC    smaller       ; a < b
        SUB   R0, R1        ; a > b: a = a - b
        JMP   loop
smaller:
        SUB   R1, R0        ; b = b - a
        JMP   loop
done:   OUT   R0
        HALT
