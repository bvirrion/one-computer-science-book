; bad_return.toy -- exercise 10: a PUSH without its POP
        LOADI R0, 3
        LOADI R2, 40
        CALL  square
        OUT   R1
        HALT
square: PUSH  R2            ; keeps R2...
        LOADI R1, 0
        LOADI R2, 0
        ADD   R2, R0
again:  ADD   R1, R0
        ADDI  R2, -1
        JNZ   again
        RET                 ; ...but RET now pops R2's 40, not the return address
