; sum.toy -- reads n, prints 1 + 2 + ... + n
        IN    R0          ; R0 = n
        LOADI R1, 0       ; R1 = running total
        LOADI R2, 1       ; R2 = the constant 1
loop:   ADD   R1, R0      ; total = total + n
        SUB   R0, R2      ; n = n - 1 (sets Z when n reaches 0)
        JNZ   loop
        OUT   R1
        HALT
