; multiply.toy -- reads a and b, prints a * b by adding a, b times
        IN    R0            ; a
        IN    R1            ; b, the number of additions left
        LOADI R2, 0         ; the product
        LOADI R3, 1
        ADDI  R1, 0         ; sets Z if b is 0
        JZ    done
loop:   ADD   R2, R0
        SUB   R1, R3
        JNZ   loop
done:   OUT   R2
        HALT
