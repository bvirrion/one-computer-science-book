; sum_array.toy -- adds the numbers of an array stored after the program
        LOADI R0, 0         ; the total
        LOADI R1, array     ; address of the next number
        LOAD  R2, [length]  ; how many are left
loop:   LOADR R3, R1        ; R3 = M[R1]
        ADD   R0, R3
        ADDI  R1, 1
        ADDI  R2, -1        ; Z when none is left
        JNZ   loop
        OUT   R0
        HALT
length: DATA  6
array:  DATA  12, 7, 30
        DATA  1, 25, 9
