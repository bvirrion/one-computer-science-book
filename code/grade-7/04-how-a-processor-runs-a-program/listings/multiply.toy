; multiply.toy -- reads a and b, prints a x b by adding a, b times
        IN    R0          ; R0 = a
        IN    R1          ; R1 = b (how many additions are left)
        LOADI R2, 0       ; R2 = the total
        LOADI R3, 1       ; R3 = the constant 1
again:  ADD   R2, R0      ; total = total + a
        SUB   R1, R3      ; one addition fewer to do
        JNZ   again
        OUT   R2
        HALT
