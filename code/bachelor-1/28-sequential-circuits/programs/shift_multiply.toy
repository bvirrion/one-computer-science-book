; shift_multiply.toy -- a * b by shifts and additions, one bit of b at a time
        IN    R0            ; a, doubled at each bit
        IN    R1            ; b, halved at each bit
        LOADI R2, 0         ; the product
loop:   ADDI  R1, 0         ; Z when no bit of b is left
        JZ    done
        SHR   R1            ; the lowest bit of b goes into C
        JC    add
        JMP   next
add:    ADD   R2, R0        ; this bit is 1: add a times its weight
next:   SHL   R0
        JMP   loop
done:   OUT   R2
        HALT
