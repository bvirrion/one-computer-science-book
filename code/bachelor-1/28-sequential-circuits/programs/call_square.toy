; call_square.toy -- a subroutine that squares R0 into R1
; capture: args=--trace
        LOADI R0, 3
        CALL  square        ; pushes the return address 4, jumps
        OUT   R1
        HALT
square: PUSH  R2            ; keep the caller's R2
        LOADI R1, 0
        LOADI R2, 0
        ADD   R2, R0        ; R2 = R0 additions to do
again:  ADD   R1, R0
        ADDI  R2, -1
        JNZ   again
        POP   R2            ; give R2 back
        RET                 ; pops 4 into PC
