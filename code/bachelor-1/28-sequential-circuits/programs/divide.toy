; divide.toy -- exercise 13: reads a and b (b > 0), prints a // b then a % b
        IN    R0            ; what is left of a
        IN    R1            ; b
        LOADI R2, 0         ; the quotient
loop:   CMP   R0, R1        ; C = 1 when R0 < b: done
        JC    done
        SUB   R0, R1
        ADDI  R2, 1
        JMP   loop
done:   OUT   R2
        OUT   R0
        HALT
