; max3.toy -- exercise 5: reads three numbers, prints the largest
        IN    R0            ; the largest so far
        IN    R1
        CMP   R0, R1        ; C = 1 when R0 < R1
        JC    take1
next:   IN    R1
        CMP   R0, R1
        JC    take2
        OUT   R0
        HALT
take1:  LOADI R0, 0
        ADD   R0, R1        ; R0 = R1
        JMP   next
take2:  OUT   R1
        HALT
