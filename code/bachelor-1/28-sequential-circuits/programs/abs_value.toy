; abs_value.toy -- reads a number from -128 to 127, prints its absolute value
        IN    R0
        ADDI  R0, 0         ; adds nothing, but sets N from bit 7
        JN    negative
        OUT   R0
        HALT
negative:
        NOT   R0            ; two's complement: flip every bit...
        ADDI  R0, 1         ; ...and add 1
        OUT   R0
        HALT
