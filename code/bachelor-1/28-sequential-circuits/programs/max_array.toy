; max_array.toy -- exercise 7: the largest number of an array
        LOADI R1, array
        LOAD  R2, [length]
        LOADI R0, 0         ; the largest so far
loop:   LOADR R3, R1
        CMP   R0, R3        ; C = 1 when R0 < R3
        JC    bigger
next:   ADDI  R1, 1
        ADDI  R2, -1
        JNZ   loop
        OUT   R0
        HALT
bigger: LOADI R0, 0
        ADD   R0, R3
        JMP   next
length: DATA  7
array:  DATA  12, 7, 130, 1, 25, 9, 64
