// ok.moor -- a global, two functions that call each other, a shadowed x
var limit: int = 3;

fn even(n: int) -> bool {
    if n == 0 { return true; }
    return odd(n - 1);
}

fn odd(n: int) -> bool {
    if n == 0 { return false; }
    return even(n - 1);
}

fn main() {
    var x = 10;
    {
        var x = limit;
        print(x);
    }
    if even(x) { print(1); } else { print(0); }
}
