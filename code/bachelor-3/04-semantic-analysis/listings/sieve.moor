// sieve.moor -- the primes below 50, and how many there are
array composite[50];

fn sieve(n: int) -> int {
    var found = 0;
    var p = 2;
    while p < n {
        if !(composite[p] == 1) {
            found = found + 1;
            print(p);
            var m = p * p;
            while m < n { composite[m] = 1; m = m + p; }
        }
        p = p + 1;
    }
    return found;
}

fn main() -> int {
    return sieve(50);
}
