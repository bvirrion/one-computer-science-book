// billing.moor -- the late fines of the town library: the days late of
// each returned loan are read, then fined and totalled in one loop.
array late[512];

fn main() -> int {
    var n = read();
    var i = 0;
    while i < n { late[i] = read(); i = i + 1; }
    var day_rate = 10;     // cents a day for the first week
    var week_rate = 25;    // cents a day after it
    var cap = 500;         // no fine above this
    var total = 0;
    var count = 0;
    var worst = 0;
    i = 0;
    while i < n {
        var days = late[i];
        var fine = 0;
        if days > 0 {
            if days <= 7 { fine = day_rate * days; }
            else { fine = 7 * day_rate + week_rate * (days - 7); }
            if fine > cap { fine = cap; }
            count = count + 1;
        }
        total = total + fine;
        if fine > worst { worst = fine; }
        i = i + 1;
    }
    print(count);
    print(total);
    print(worst);
    return 0;
}
