# ex6_moor_for.grammar -- moor.grammar with a for loop: for i = a to b [step c] { ... }
Program -> Item Program | eps
Item    -> fn id ( Params ) Ret Block | var id : Type Init ; | array id [ num ] ;
Params  -> Param MoreP | eps
MoreP   -> , Param MoreP | eps
Param   -> id : Type
Ret     -> -> Type | eps
Type    -> int | bool
Init    -> = Lit | eps
Lit     -> num | - num | true | false
Block   -> { Stmts }
Stmts   -> Stmt Stmts | eps
Stmt    -> var id VarT = E ; | if E Block Else | while E Block | return RetV ;
         | Block | id IdStmt | NotId ; | for id = E to E Step Block
Step    -> step E | eps
VarT    -> : Type | eps
RetV    -> E | eps
Else    -> else ElseR | eps
ElseR   -> Block | if E Block Else
IdStmt  -> = E ; | ( Args ) Tail ; | [ E ] IdxR | Tail ;
IdxR    -> = E ; | Tail ;
NotId   -> num Tail | true Tail | false Tail | ( E ) Tail | - Un Tail | ! Un Tail
Tail    -> Mul' Add' Cmp' Eq' And' Or'
E       -> And Or'
Or'     -> || And Or' | eps
And     -> Eq And'
And'    -> && Eq And' | eps
Eq      -> Cmp Eq'
Eq'     -> == Cmp Eq' | != Cmp Eq' | eps
Cmp     -> Add Cmp'
Cmp'    -> < Add Cmp' | <= Add Cmp' | > Add Cmp' | >= Add Cmp' | eps
Add     -> Mul Add'
Add'    -> + Mul Add' | - Mul Add' | eps
Mul     -> Un Mul'
Mul'    -> * Un Mul' | / Un Mul' | % Un Mul' | eps
Un      -> - Un | ! Un | Prim
Prim    -> num | true | false | ( E ) | id Post
Post    -> ( Args ) | [ E ] | eps
Args    -> E MoreA | eps
MoreA   -> , E MoreA | eps
