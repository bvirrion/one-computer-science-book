# fines.grammar -- the library's formulas, LL(1) (weekend problem)
E    -> A E'
E'   -> or A E' | eps
A    -> Q A'
A'   -> and Q A' | eps
Q    -> C Q'
Q'   -> == C Q' | != C Q' | eps
C    -> S C'
C'   -> < S C' | <= S C' | > S C' | >= S C' | eps
S    -> M S'
S'   -> + M S' | - M S' | eps
M    -> P M'
M'   -> * P M' | / P M' | eps
P    -> U P'
P'   -> ^ P | eps
U    -> num | ( E ) | name Call
Call -> ( E MoreA ) | eps
MoreA -> , E MoreA | eps
