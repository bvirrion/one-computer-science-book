// sum_array.moor -- fill an array with squares, then sum it
array sq[10];

fn fill(n: int) {
    var i = 0;
    while i < n { sq[i] = i * i; i = i + 1; }
}

fn main() -> int {
    fill(10);
    var total = 0;
    var i = 0;
    while i < 10 { total = total + sq[i]; i = i + 1; }
    print(total);
    return total;
}
