// primes.moor -- the primes below 30 by trial division, without '%'
fn divides(d: int, n: int) -> bool {
    return n - n / d * d == 0;
}

fn is_prime(n: int) -> bool {
    if n < 2 { return false; }
    var d = 2;
    while d * d <= n {
        if divides(d, n) { return false; }
        d = d + 1;
    }
    return true;
}

fn main() -> int {
    var count = 0;
    var n = 0;
    while n < 30 {
        if is_prime(n) { print(n); count = count + 1; }
        n = n + 1;
    }
    return count;
}
