% #1 path, #2 first line, #3 last line, #4 caption; a \label may follow.
% A \label written right after \omcode{...} is absorbed and passed to listings
% as its label= key: listings typesets inside its own group, so a trailing
% \label would otherwise resolve to the enclosing section.
\newcommand{\omcode}[4]{%
  \def\om@code@args{{#1}{#2}{#3}{#4}}%
  \@ifnextchar\label{\om@code@withlabel}{\expandafter\om@code@do\om@code@args{}}}
\def\om@code@withlabel\label#1{\expandafter\om@code@do\om@code@args{label={#1},}}
\def\om@code@do#1#2#3#4#5{%
  \begingroup\om@lstlang{#1}%
  \lstinputlisting[firstline=#2,lastline=#3,firstnumber=#2,#5
    caption={#4\ \ {\scriptsize\ttfamily\color{omExo}\detokenize{#1}}}]{#1}%
  \endgroup}
\lstdefinestyle{omout}{style=om, language={}, numbers=none, frame=single, framerule=0.3pt,
  rulecolor=\color{black!35}, backgroundcolor=\color{black!5}, xleftmargin=4pt, framexleftmargin=3pt,
  basicstyle=\ttfamily\scriptsize, keywordstyle={}, commentstyle={}, stringstyle={}, breakatwhitespace=false,
  belowskip=0pt}
