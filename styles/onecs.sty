% ============================================================================
% onecs.sty — shared style for the One Computer Science Book project
%
% All packages, theorem environments and macros live here. Chapter files must
% not load packages or define macros: if you need something new, add it here
% and document it in CONTRIBUTING.md.
%
% Language: set \booklang before loading (default en). UI strings and part
% titles live in styles/lang/<lang>.tex. Chapter bodies for non-English
% languages live under parts/<year>/<lang>/ (see \ominput / \ominputsol).
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{onecs}[2026/11/19 v0.1 One Computer Science Book common style]

% ----------------------------------------------------------------------------
% Language selection (default: English)
% ----------------------------------------------------------------------------
\providecommand{\booklang}{en}

% ----------------------------------------------------------------------------
% Core packages
% ----------------------------------------------------------------------------
% Engine / script detection. Hindi editions use Devanagari and must be built
% with XeLaTeX (or LuaLaTeX); pdfTeX cannot load OpenType Devanagari fonts.
% Other languages stay on the historical pdfTeX path (T1 + lmodern).
\RequirePackage{iftex}
\edef\om@booklang@exp{\booklang}%
\def\om@lang@fr{fr}%
\def\om@lang@nl{nl}%
\def\om@lang@es{es}%
\def\om@lang@pt{pt}%
\def\om@lang@id{id}%
\def\om@lang@hi{hi}%
\def\om@lang@ar{ar}%
\def\om@lang@zh{zh}%
\newif\ifom@hindi
\newif\ifom@arabic
\newif\ifom@chinese
\ifx\om@booklang@exp\om@lang@zh
  \om@chinesetrue
\fi
\ifx\om@booklang@exp\om@lang@hi
  \om@hinditrue
\fi
\ifx\om@booklang@exp\om@lang@ar
  \om@arabictrue
\fi

\ifom@hindi
  \ifPDFTeX
    \PackageError{onecs}{%
      Hindi editions require XeLaTeX (or LuaLaTeX).\MessageBreak
      Use: xelatex \jobname.tex\MessageBreak
      (or latexmk, which picks XeLaTeX for *_hi.tex)}{Build with XeLaTeX.}%
  \fi
  \RequirePackage{fontspec}%
  % Bundled under assets/fonts/ so CI and local builds do not depend on
  % system font packages. Noto Sans Devanagari covers Devanagari + basic Latin.
  % (Same path as onemath.sty; SI micro µ uses math \mu — see siunitx setup.)
  %
  % Noto Sans Devanagari ships Regular and Bold only: no italic, no small
  % caps. Left undeclared, every \emph and \textsc raised "Font shape
  % TU/NotoSansDevanagari(0)/m/it undefined" and silently fell back to
  % upright — so every defined term, marked \emph{term}\index{term} inside a
  % definition, was typographically invisible in the Hindi PDF. Alias the
  % missing shapes onto the faces we have, then carry emphasis with WEIGHT,
  % which is what Devanagari typography does: the script has no italic.
  \IfFileExists{assets/fonts/NotoSansDevanagari-Regular.ttf}{%
    \setmainfont{NotoSansDevanagari}[%
      Path=assets/fonts/,%
      Extension=.ttf,%
      UprightFont=*-Regular,%
      BoldFont=*-Bold,%
      ItalicFont=*-Regular,%
      BoldItalicFont=*-Bold,%
      SmallCapsFont=*-Regular,%
      Script=Devanagari,%
    ]%
  }{%
    \setmainfont{Noto Sans Devanagari}[Script=Devanagari]%
  }%
  % \emph -> bold at the first level, upright at the second (nested emphasis
  % toggles back, as \em does in Latin scripts). \DeclareEmphSequence is the
  % supported hook for this; do not \renewcommand\emph, which breaks nesting.
  \DeclareEmphSequence{\bfseries,\normalfont}%
  % Table of contents: book.cls sizes the page-number box at \@pnumwidth =
  % 1.55em, which fits three Latin Modern digits. Noto Sans Devanagari's
  % digits are wider, so every three-digit entry overflowed by exactly
  % 1.12782pt -- that single cause accounted for ALL 141 overfull boxes in
  % the Hindi edition, while every other language sat at zero. Not a prose
  % problem: the log shows no "Overfull \hbox ... in paragraph" at all, so
  % Hindi needs no hyphenation patterns here. Widen the box and push the
  % entry's right margin out by the same amount.
  \renewcommand{\@pnumwidth}{2.2em}%
  \renewcommand{\@tocrmarg}{3.2em}%
\else
  \ifom@arabic
    % Arabic is the first right-to-left edition. It needs LuaTeX, not XeTeX:
    % the bidirectional engine we use is babel's own "bidi=basic", which is
    % implemented in Lua and therefore does not patch LaTeX internals the way
    % the xetex "bidi" package does. That matters here because this stack
    % leans on tcolorbox[most], tikz, pgfplots, circuitikz and hyperref, all
    % of which "bidi" is known to fight with. See the babel block below for
    % the four fixes the combination still needs.
    \ifLuaTeX\else
      \PackageError{onecs}{%
        Arabic editions require LuaLaTeX.\MessageBreak
        Use: lualatex \jobname.tex\MessageBreak
        (or latexmk, which picks LuaLaTeX for *_ar.tex)}{Build with LuaLaTeX.}%
    \fi
    \RequirePackage{fontspec}%
  \else
  \ifom@chinese
    % Simplified Chinese (2026-11-16): XeLaTeX + xeCJK, the Fandol faces that
    % ship with TeX Live itself (here and in CI's texlive-full), loaded by file
    % name so no system font is involved. Latin text and mathematics keep Latin
    % Modern. xeCJK drops the newline between two Chinese characters, so a
    % sentence may wrap anywhere in the source, and inserts the CJK/Latin gap
    % itself. \emph -- the series' marker for a defined term -- maps onto the
    % italic shape, which is Kai here: the textbook convention for a term.
    \ifXeTeX\else
      \PackageError{onechemistry}{%
        Chinese editions require XeLaTeX.\MessageBreak
        Use: xelatex \jobname.tex\MessageBreak
        (or latexmk, which picks XeLaTeX for *_zh.tex)}{Build with XeLaTeX.}%
    \fi
    \RequirePackage{fontspec}%
    \RequirePackage[AutoFallBack=false]{xeCJK}%
    \setCJKmainfont{FandolSong-Regular.otf}[%
      BoldFont=FandolSong-Bold.otf,%
      ItalicFont=FandolKai-Regular.otf,%
      BoldItalicFont=FandolKai-Regular.otf,%
      BoldItalicFeatures={FakeBold=2},%
    ]%
    \setCJKsansfont{FandolHei-Regular.otf}[BoldFont=FandolHei-Bold.otf]%
    \setCJKmonofont{FandolFang-Regular.otf}%
    % Unicode Greek typed in Chinese prose (α 射线, μ子, π 介子) and the Roman numerals Ⅰ–Ⅻ (铜（Ⅱ）): Latin Modern has neither, Fandol has both,
    % so xeCJK sets it in the CJK face; math Greek (\alpha) is untouched (physics Book 2, 2026-11-18)
    \xeCJKDeclareCharClass{CJK}{"0391 -> "03A9, "03B1 -> "03C9, "2160 -> "216B}%
  \else
    \ifPDFTeX
      \RequirePackage[T1]{fontenc}%
      \RequirePackage[utf8]{inputenc}%
      \RequirePackage{lmodern}%
    \fi
  \fi
  \fi
\fi
\RequirePackage{microtype}
% microtype letterspacing (\textls) is not implemented for XeTeX; Hindi
% editions use XeLaTeX for Devanagari. Provide a no-op so the cover wordmark
% and branded header still compile (tracking is cosmetic).
\ifXeTeX
  \DeclareRobustCommand{\textls}[2][]{#2}%
\fi
\RequirePackage[a4paper,inner=2.2cm,outer=2.2cm,top=2.4cm,bottom=2.6cm,headheight=14pt]{geometry}

% babel: only for non-English editions (keeps English builds unchanged).
% Compare expanded token lists so \newcommand{\booklang}{fr} matches.
% Load language babel only when the .ldf is installed; UI strings still
% come from styles/lang/<lang>.tex either way.
% Hindi: no babel (no babel-hindi in our stack); UI strings from
% styles/lang/hi.tex and colon-safe labels without active characters.
% shorthands=off: French (and Dutch/Spanish/Portuguese) babel makes characters
% such as ":" active for punctuation spacing. Our labels use colons throughout
% (type:year:slug:name) and cleveref cannot parse active characters in
% label names — CI with full TeX Live would fail at the first \cref.
% French/Dutch sources already use ~ before :;!? for spacing.
\ifx\om@booklang@exp\om@lang@fr
  \IfFileExists{french.ldf}{%
    \RequirePackage[french,shorthands=off]{babel}%
  }{%
    \PackageWarning{onecs}{%
      french.ldf not found; building French without babel.
      Install texlive-lang-french for hyphenation}%
  }%
\fi
\ifx\om@booklang@exp\om@lang@nl
  \IfFileExists{dutch.ldf}{%
    \RequirePackage[dutch,shorthands=off]{babel}%
  }{%
    \PackageWarning{onecs}{%
      dutch.ldf not found; building Dutch without babel.
      Install texlive-lang-european (or babel-dutch) for hyphenation}%
  }%
\fi

\ifx\om@booklang@exp\om@lang@es
  \IfFileExists{spanish.ldf}{%
    \RequirePackage[spanish,es-noshorthands,shorthands=off]{babel}%
    % babel-spanish redefines \% to auto-insert a thin space; its
    % \lastskip probe is fatal after a math \, (mu-glue), and the
    % sources set the space explicitly ($t\,\%$, as in fr/nl).
    \spanishplainpercent
  }{%
    \PackageWarning{onecs}{%
      spanish.ldf not found; building Spanish without babel.
      Install texlive-lang-spanish for hyphenation}%
  }%
\fi
\ifx\om@booklang@exp\om@lang@pt
  \IfFileExists{brazilian.ldf}{%
    \RequirePackage[brazilian,shorthands=off]{babel}%
  }{%
    \IfFileExists{portuguese.ldf}{%
      \RequirePackage[portuguese,shorthands=off]{babel}%
    }{%
      \IfFileExists{portuges.ldf}{%
        \RequirePackage[portuges,shorthands=off]{babel}%
      }{%
        \PackageWarning{onecs}{%
          brazilian/portuguese.ldf not found; building Portuguese without babel.
          Install texlive-lang-portuguese for hyphenation}%
      }%
    }%
  }%
\fi

% Indonesian: babel-indonesian declares no shorthands, no active characters
% and no command redefinitions (its "extras" hook is empty), so neither the
% babel-spanish \% trap nor any of the Hindi/Arabic script work applies here.
% shorthands=off is kept only for the house reason: our labels carry colons.
% The engine stays pdfTeX and hyphenation comes from hyph-id through babel.
\ifx\om@booklang@exp\om@lang@id
  \IfFileExists{bahasai.ldf}{%
    \RequirePackage[bahasai,shorthands=off]{babel}%
  }{%
    \IfFileExists{indonesian.ldf}{%
      \RequirePackage[indonesian,shorthands=off]{babel}%
    }{%
      \PackageWarning{onecs}{%
        bahasai/indonesian.ldf not found; building Indonesian without babel.
        Install texlive-lang-other (babel-indonesian) for hyphenation}%
    }%
  }%
\fi

% ----------------------------------------------------------------------------
% Arabic: right-to-left, via babel's Lua bidi engine.
%
% "layout=graphics" is load-bearing, not cosmetic. Without it every pgfpicture
% -- which includes the frame of every tcolorbox, i.e. every statement
% environment in the series -- is drawn mirrored about the picture origin, so
% the coloured box lands beside its own text, off the page. babel's own patch
% (luababel.def, \bbl@pictsetdir) typesets pictures left-to-right and then
% re-applies RTL at each tikz node, which is exactly what figures need: the
% drawing coordinates stay untouched and only the node text reads RTL.
%
% Four more fixes live after the packages load; see "Arabic runtime fixes"
% below.
% ----------------------------------------------------------------------------
\ifom@arabic
  % layout=tabular is the second load-bearing one. babel's bidi=basic
  % implements the Unicode algorithm's W1-W7 and N1-N2 but NOT N0, the paired
  % bracket rule, so a table cell like "$V$ (\unit{mL})" ended with its
  % closing parenthesis taking the paragraph direction: the cell rendered
  % "(mLV (", with two opening brackets and none closing. \babelsublr around
  % the cell does not help -- the direction is decided for the cell box.
  % layout=tabular fixes the cells and, correctly for a right-to-left book,
  % orders the columns right to left. Prose is unaffected: a parenthesised
  % Latin run inside an Arabic sentence already resolved correctly, because
  % there the closing bracket has following context to key on.
  \RequirePackage[bidi=basic,layout=graphics.tabular]{babel}%
  % Table of contents. Arabic prose uses ASCII digits, so this looked like it
  % would not be needed -- but it is: Noto Naskh Arabic's ASCII digits are
  % themselves wider than Latin Modern's, and every three-digit contents entry
  % overflowed \@pnumwidth by 1.39063pt. That single cause produced 147 of the
  % 149 overfull boxes in the first Arabic build, against 0 for English; the
  % log said "detected at line", i.e. a box, not "in paragraph", so this is not
  % a hyphenation problem and Arabic needs no patterns here either.
  \renewcommand{\@pnumwidth}{2.2em}%
  \renewcommand{\@tocrmarg}{3.2em}%
  \babelprovide[import,main]{arabic}%
  % Two bundled STATIC faces, cut from the Noto Naskh Arabic variable font at
  % wght 400 and 700. Noto Naskh is a book face and these instances carry the
  % full Arabic block AND full ASCII (95/95), which matters because the prose
  % is full of parentheses, ASCII digits and Latin symbols -- the Noto Naskh
  % statics published upstream have no ASCII at all, not even "(", which is
  % why the variable font was bundled originally.
  %
  % DO NOT go back to instancing the variable font at run time
  % (RawFeature={axis={wght=...}} or instance=Bold). luaotfload's variable
  % instancing SEGFAULTS LuaHBTeX 1.24 on musl libc, which is what CI runs
  % (ghcr.io/xu-cheng/texlive-full is Alpine). It killed the Arabic Book 5
  % release build at page 308 with no error in the log at all, while the same
  % engine on glibc built it perfectly -- so a local build proves nothing
  % here. Any axis value crashed, including wght=400, the font's own default.
  % The instances were cut once, offline:
  %
  %   python3 -c "from fontTools.ttLib import TTFont; \
  %     from fontTools.varLib import instancer; \
  %     f=TTFont('NotoNaskhArabic-VF.ttf'); \
  %     instancer.instantiateVariableFont(f,{'wght':700},inplace=True, \
  %       updateFontNames=True).save('NotoNaskhArabic-Bold.ttf')"
  %
  % NotoNaskhArabic-VF.ttf is kept beside them ONLY as the source for that
  % command. Nothing loads it, and nothing should. Re-running the command
  % reproduces the committed faces exactly apart from the head-table
  % timestamp, so compare glyphs and metrics, not md5sums.
  %
  % Arabic has no italic and no small caps; left undeclared, the bold shape
  % comes out undefined and every \emph{term}\index{term} -- the series'
  % marker for a defined term -- is typographically invisible, exactly as it
  % was in Hindi before its fix.
  \IfFileExists{assets/fonts/NotoNaskhArabic-Regular.ttf}{%
    \babelfont{rm}[%
      Path=assets/fonts/,%
      Extension=.ttf,%
      UprightFont=*-Regular,%
      BoldFont=*-Bold,%
      ItalicFont=*-Regular,%
      BoldItalicFont=*-Bold,%
      SmallCapsFont=*-Regular,%
      Script=Arabic,%
    ]{NotoNaskhArabic}%
  }{%
    \babelfont{rm}[Script=Arabic]{Noto Naskh Arabic}%
  }%
  % Emphasis by weight, as in the Hindi edition: the script has no italic
  % tradition. \DeclareEmphSequence is the supported hook; do not
  % \renewcommand\emph, which breaks nesting.
  \DeclareEmphSequence{\bfseries,\normalfont}%
\fi


\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathtools}
\RequirePackage{enumitem}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
% Every figdata/out/*.dat table has a header row (figdata/_table.py
% write_table). Say so, so pgfplots does not guess: newer pgfplots read
% "ddg eeA eeB eeC" as numbers and broke the release build.
\pgfplotsset{table/header=has colnames}
\usepgfplotslibrary{fillbetween}
\usetikzlibrary{arrows.meta,calc,angles,quotes,patterns}
% Figures use path decorations, relative positioning, intersections,
% geometric shapes, fitted groups, and layered backgrounds.
\usetikzlibrary{decorations.pathmorphing,decorations.markings,positioning,intersections}
\usetikzlibrary{shapes.geometric,shapes.misc,fit,backgrounds,matrix}
% Units: \qty{3.5}{m/s}, \unit{kW.h}, \num{6.02e23}. list/range separators in
% text mode so they inherit the surrounding font.
\RequirePackage{siunitx}
\sisetup{per-mode=symbol, output-decimal-marker={.}, range-units=single}
% Hindi (XeTeX + Noto Sans Devanagari): siunitx v3 injects Unicode µ (U+00B5)
% and Ω (U+2126) under XeTeX; those glyphs are absent from the Devanagari face.
% Redeclare prefixes/units with math symbols (math-micro options were removed in v3).
% The same holds for Arabic (LuaTeX + Noto Naskh Arabic): U+00B5, U+2126,
% U+03BC and U+03A9 are all absent from that face too, so both Unicode-engine
% editions need the patch and the Latin pdfTeX editions need none of it.
\newif\ifom@unicodeface
\ifom@hindi\om@unicodefacetrue\fi
\ifom@arabic\om@unicodefacetrue\fi
\ifom@chinese\om@unicodefacetrue\fi% xeCJK + fontspec: a Unicode engine too (zh run, 2026-11-18)
\ifom@unicodeface
  \AtBeginDocument{%
    \DeclareSIPrefix{\micro}{\ensuremath{\mu}}{-6}%
    % Not \Omega: inside siunitx's \mathrm that \mathalpha glyph takes the Devanagari or
    % Arabic family and prints nothing, so 130 ohm m read "130 m". The only sign is
    % "Missing character" for U+000A, with exit 0 (Book 5, ch. 31, 2026-11-03).
    \DeclareSIUnit{\ohm}{\ensuremath{\mathchar\numexpr\symlegacymaths*256+10\relax}}%
  }%
  % The per-mil sign: \textperthousand prints U+2030, which neither face has,
  % so the delta-18-O values of Book 4 (ch. 11) lost their unit in the hi/ar
  % probes ("Missing character: There is no ‰", exit 0). Take the glyph from
  % Latin Modern, which TeX Live ships as OpenType (2026-10-06).
  \newfontfamily\om@latinsym{lmroman10-regular.otf}%
  \AtBeginDocument{\renewcommand{\textperthousand}{{\om@latinsym\symbol{"2030}}}}%
\fi
% Unbreakable in-text figure block: keeps a picture and its caption line
% on the same page. Use in place of "center" around tikzpicture figures.
% The [b] alignment matters: with the default [c] the minipage's huge box
% *depth* is invisible to the page breaker beyond \maxdepth, so a figure at
% the bottom of a page silently overprints the footer (page number over the
% caption). Bottom alignment keeps the whole box above the baseline.
\newenvironment{omfigure}
  {\par\medskip\noindent\begin{minipage}[b]{\linewidth}\centering}
  {\end{minipage}\par\medskip}

% Raster images live under images/book<N>/ (photographs) and images/book<N>/ai/
% (illustrations). Chapters give the full path from the repo root.
\graphicspath{{images/}}
% #1 = file (with or without assets/ prefix), #2 = width, #3 = caption
\newcommand{\omimg}[3]{%
  \begin{omfigure}%
    \includegraphics[width=#2]{#1}%
    \par\smallskip{\small #3}%
  \end{omfigure}%
}

% Shared axis style for in-text figures: use with \begin{axis}[omaxis, ...].
\pgfplotsset{
  omaxis/.style={
    axis lines=middle,
    tick label style={font=\small},
    label style={font=\small},
    xlabel={$x$}, ylabel={$y$},
    xlabel style={below right}, ylabel style={above left},
    samples=100,
  },
}
\RequirePackage[most]{tcolorbox}
\RequirePackage{imakeidx}
\makeindex[intoc]
\RequirePackage[colorlinks=true,linkcolor=blue!50!black,urlcolor=blue!50!black]{hyperref}
\RequirePackage[nameinlink,capitalize]{cleveref}
\RequirePackage{etoolbox}

% ----------------------------------------------------------------------------
% Arabic runtime fixes. These must come AFTER mathtools, tikz, pgfplots and
% tcolorbox are loaded, because each one repairs an interaction with them.
% All four were found by building the real chapters, not by reading docs; a
% green log does not reveal any of them, only the rendered page does.
% ----------------------------------------------------------------------------
\ifom@arabic
  % 1. babel vs mathtools. luababel.def does \bbl@sreplace\intertext@{...}
  %    when an RTL language is provided. mathtools has already redefined
  %    \intertext@ in expl3 syntax, and \bbl@sreplace re-tokenises that body
  %    WITHOUT expl3 catcodes, so \l_MT_below_intertext_sep comes back as \l
  %    followed by garbage. Every single align/gather in the book then fails
  %    with "Undefined control sequence". Save mathtools' meaning here and put
  %    it back after babel's own \AtBeginDocument patch has run (ours is
  %    declared later, so it runs later). \intertext is used nowhere in the
  %    sources, so losing babel's baseline tweak for it costs nothing.
  \let\om@saved@intertext\intertext@
  \AtBeginDocument{\let\intertext@\om@saved@intertext}%
  % 2. Whole pictures are typeset left-to-right. layout=graphics already does
  %    this for pgfpicture, but pgfplots places its axis label and tick label
  %    rows outside the tikz-node path that babel re-orients, so an axis came
  %    out with its x labels mirrored and shifted a full picture-width left.
  %    Use babel's OWN \bbl@textdir, not the raw \textdir primitive: the
  %    primitive changes TeX's direction but not the attribute babel's Lua
  %    filter reads, so the filter still walked the picture as RTL and died
  %    with "babel-bidi-basic.lua:345: attempt to index a nil value" on the
  %    first pgfplots mark glyph. Forcing it properly fixes the whole
  %    node, so Arabic node text reads correctly.
  \AddToHook{env/tikzpicture/before}{\leavevmode\begingroup\bbl@textdir\z@}%
  \AddToHook{env/tikzpicture/after}{\endgroup}%
  %    modiagram's MOdiagram is not reached by the tikzpicture hook: every MO
  %    diagram came out mirrored (correlation lines flying off to the right,
  %    labels "*σ1" for σ*1s, side-by-side diagrams overlapping), with a clean
  %    log (Arabic chemistry Book 3 agent, 2026-10-06). Same cure.
  \AddToHook{env/MOdiagram/before}{\leavevmode\begingroup\bbl@textdir\z@}%
  \AddToHook{env/MOdiagram/after}{\endgroup}%
  %    The character tables (omchartable) set an array in INLINE math, which
  %    the RTL paragraph reversed inside every cell: "C_{2v}" printed "2v C",
  %    "A_1" printed "1 A" (Arabic chemistry Book 4, ch. 4; found on the rendered
  %    page by the coordinator, 2026-10-07; no gate or log sees it).
  \AddToHook{env/omchartable/before}{\begingroup\bbl@textdir\z@\bbl@pardir\z@}%
  \AddToHook{env/omchartable/after}{\endgroup}%
  % 3. ... but tcolorbox builds its content INSIDE that left-to-right picture
  %    scope, so without this the Arabic inside every definition, theorem and
  %    exercise box came out in reversed word order. Put the box body back to
  %    RTL.
  \tcbset{before upper={\pardir TRT\textdir TRT}}%
  % 4. pgfplots axis labels and titles are Arabic prose and must read RTL
  %    inside the otherwise left-to-right picture.
  \pgfplotsset{every axis/.append style={%
    label style={execute at begin node={\pardir TRT\textdir TRT}},%
    title style={execute at begin node={\pardir TRT\textdir TRT}},%
  }}%
  % 5. LuaTeX overflows a heap buffer when a box report (underfull/overfull)
  %    prints a glyph whose name is a raw control byte, e.g. cmsy's \times.
  %    glibc hides it; musl, i.e. the Alpine CI image, segfaults, which killed
  %    the Arabic Book 1 release build at page 377 with nothing in the log.
  %    The Lua file wraps luaotfload's glyph_info callback to hand those
  %    bytes back already escaped; it explains the bug in full. Loaded at
  %    \begin{document} so that luaotfload has registered the callback.
  \AtBeginDocument{\directlua{dofile('styles/onecs-glyphinfo.lua')}}%
  % 6. Statement heads: amsthm sets the head in a list-item label box, and
  %    babel's bidi=basic never mirrors the brackets in there (the body's
  %    brackets ARE mirrored) -- so every "Exercise 4.1 (**)." printed with
  %    its brackets facing OUTWARD. Found by the Arabic chemistry Book 1 agent,
  %    2026-10-04 (ported here 2026-10-24). No direction switch changes that;
  %    writing the brackets swapped does. amsthm's own \thmhead@plain, with
  %    ")#3(" for "(#3)" (\patchcmd cannot retokenise it).
  \def\thmhead@plain#1#2#3{%
    \thmname{#1}\thmnumber{\@ifnotempty{#1}{ }\@upn{#2}}%
    \thmnote{ {\the\thm@notefont)#3(}}}%
  \let\thmhead\thmhead@plain
  % 7. An empty line before every breakable box. A breakable tcolorbox opens
  %    a paragraph only to apply \parskip and closes it at once, and TeX
  %    drops an empty paragraph. But babel's tcolorbox hook sets \textdir
  %    TLT in vertical mode, LuaTeX replays that direction into the next
  %    paragraph as a dir node, and the paragraph is no longer empty: a
  %    zero-height line is left before the box. Mostly it only adds a
  %    \baselineskip. At the foot of a page it moved to the next page, and
  %    the \pagebreak that follows when the box does not fit shipped it
  %    alone: two blank pages in the Arabic Book 2 (2026-10-26). Remove the
  %    dir nodes from that paragraph only when it holds nothing else.
  \directlua{
    function onecs_drop_empty_par()
      local top = tex.nest.top
      local DIR, LPAR = node.id('dir'), node.id('local_par')
      local n = top.head.next
      while n do
        if not (n.id == DIR or n.id == LPAR) then return end
        n = n.next
      end
      n = top.head.next
      while n do
        local nx = n.next
        if n.id == DIR then top.head = node.remove(top.head, n) end
        n = nx
      end
      top.tail = node.tail(top.head)
    end
  }%
  \patchcmd{\tcb@prepare@break@operation}{\noindent\vskip\lineskip}%
    {\noindent\ifhmode\directlua{onecs_drop_empty_par()}\fi\vskip\lineskip}%
    {}{\PackageWarning{onecs}{Could not patch tcolorbox's breakable
      start: Arabic boxes may leave empty lines and blank pages}}%
\fi

