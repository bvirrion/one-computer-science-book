% ----------------------------------------------------------------------------
% Drawing styles for the series (TikZ). Use them before inventing new ones.
%   cell          -- one memory cell / array slot (\node[cell]{42};), 8 mm square
%   cell small    -- 6 mm
%   ptr           -- a pointer arrow (-Stealth, thick, omDef)
%   frame box     -- a stack frame or a heap block (rounded, light fill)
%   tnode         -- a tree node (circle); leafbox -- a rectangular leaf
%   gnode         -- a graph vertex; gedge -- an edge; wedge -- weight label
%   packet field  -- a field of a packet header (use bytefield for exact layouts)
%   window        -- pic {window={<w>}{<h>}{<title>}}: a generic window with a
%                    title bar and three round buttons, origin at the lower left
%   keycap        -- one key of a drawn keyboard (\node[keycap]{A};)
% Automata: TikZ's automata library (state, initial, accepting). Logic gates:
% circuitikz (and port, or port, not port, xor port, nand port, nor port) or
% the circuits.logic.US library. Trees: forest. Plots: pgfplots with omrecord.
% ----------------------------------------------------------------------------
\tikzset{
  cell/.style={draw, minimum width=8mm, minimum height=8mm, inner sep=1pt,
    font=\ttfamily\small, anchor=center},
  cell small/.style={cell, minimum width=6mm, minimum height=6mm, font=\ttfamily\footnotesize},
  ptr/.style={-{Stealth[length=2.2mm]}, thick, omDef},
  frame box/.style={draw=omCode, rounded corners=2pt, fill=omCode!5, inner sep=4pt},
  tnode/.style={circle, draw, minimum size=7mm, inner sep=1pt, font=\small},
  leafbox/.style={rectangle, draw, minimum size=6mm, inner sep=1pt, font=\small},
  gnode/.style={circle, draw, fill=white, minimum size=6.5mm, inner sep=1pt, font=\small},
  gedge/.style={thick},
  wedge/.style={font=\footnotesize, fill=white, inner sep=1pt},
  packet field/.style={draw, minimum height=7mm, font=\footnotesize, inner sep=2pt},
  keycap/.style={draw=black!60, rounded corners=1.5pt, fill=black!4,
    minimum width=7mm, minimum height=7mm, font=\footnotesize\sffamily, inner sep=1pt},
  window/.pic={%
    \draw[black!70, fill=white, rounded corners=1.5pt] (0,0) rectangle (\omwinw,\omwinh);
