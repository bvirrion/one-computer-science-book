% Book 1: a drawn keyboard (grade 2 keyboard-and-mouse, grade 3 typing, the
% typing appendix). The main block only, drawn generically (no brand key).
% Legends from the system's xkb layout files (ledger typ:layout:us/fr/de):
% us = QWERTY, fr = AZERTY, de = QWERTZ; us has the one-row Enter key, fr and
% de the two-row Enter and the extra key beside the left Shift.
%   \omkeyboard[<options>]{us}       a tikzpicture of the keyboard
%   \omkeyboardkeys[<options>]{fr}   the keys only, inside your own tikzpicture
% Options: unit=<length> (key pitch, default 0.9cm, 15 units wide);
%   fingers (finger zones: the same tint for the same finger of both hands --
%   little mint, ring yellow, middle red, index blue, thumbs grey);
%   home (the bumps on the F and J keys); highlight={AC01,AC04} (keys by xkb
%   name, no spaces: a thick outline, and a yellow fill without fingers);
%   nolegend (blank keys).
% Every key is a node kb-<xkb name>, e.g. kb-AE01 (the 1 key of QWERTY),
% kb-AD01, kb-AC01, kb-AB01, kb-TLDE, kb-BKSL, kb-LSGT, kb-TAB, kb-CAPS, kb-LFSH,
% kb-RTSH, kb-BKSP, kb-RTRN, kb-SPCE, kb-LCTL, kb-LALT, kb-RALT, kb-RCTL, for
% arrows and labels. The origin is the top-left corner; rows go down by 1 unit.
% The words on the modifier keys are \omkbTab ... below (a language edition
% may redefine them).
\newif\ifomkb@fingers \newif\ifomkb@home \newif\ifomkb@nolegend \newif\ifomkb@hit
\pgfkeys{/omkb/.is family, /omkb/.cd,
  unit/.store in=\omkb@u, unit=0.9cm,
  fingers/.is if=omkb@fingers, home/.is if=omkb@home, nolegend/.is if=omkb@nolegend,
  highlight/.store in=\omkb@hl, highlight={}}
\colorlet{omkbP}{ocMint!32!white}
\colorlet{omkbR}{ocYellow!55!white}
\colorlet{omkbM}{ocRed!30!white}
\colorlet{omkbI}{ocBlue!50!white}
\colorlet{omkbT}{black!12}
\colorlet{omkbH}{ocYellow!80!white}
\def\omkb@zc@P{omkbP}\def\omkb@zc@R{omkbR}\def\omkb@zc@M{omkbM}\def\omkb@zc@I{omkbI}
\def\omkb@zc@J{omkbI}\def\omkb@zc@N{omkbM}\def\omkb@zc@S{omkbR}\def\omkb@zc@Q{omkbP}
\def\omkb@zc@T{omkbT}
