% A list opening as the very first thing in a statement environment used to
% typeset its first item on the run-in heading's line ("Method 25.6  1. …"):
% amsthm holds the heading as a pending trivlist label, and the first \item
% attaches itself to it. While that label is pending @inlabel is true, so
% \leavevmode there commits the heading to its own paragraph and the list
% starts on a fresh line; lists that follow normal text are untouched.
\newcommand{\om@listafterhead}{\if@inlabel\leavevmode\fi}
\AtBeginEnvironment{enumerate}{\om@listafterhead}
\AtBeginEnvironment{itemize}{\om@listafterhead}
\AtBeginEnvironment{description}{\om@listafterhead}

