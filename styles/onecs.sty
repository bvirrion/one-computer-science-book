\def\omkb@iso@us{0}\def\omkb@iso@fr{1}\def\omkb@iso@de{1}
% legends: \omkb@one{layout}{key}{capital} or \omkb@two{layout}{key}{with Shift}{without}
\def\omkb@one#1#2#3{\expandafter\def\csname omkb@l@#1@#2\endcsname{\omkb@showone{#3}}}
\def\omkb@two#1#2#3#4{\expandafter\def\csname omkb@l@#1@#2\endcsname{\omkb@showtwo{#3}{#4}}}
\def\omkb@showone#1{\node[font=\sffamily\footnotesize, inner sep=0] at (kb-\omkb@cur.center) {#1};}
\def\omkb@showtwo#1#2{%
  \node[font=\sffamily\scriptsize, anchor=north west, inner sep=1.6pt] at (kb-\omkb@cur.north west) {\strut#1};%
  \node[font=\sffamily\scriptsize, anchor=south west, inner sep=1.6pt] at (kb-\omkb@cur.south west) {\strut#2};}
% the fill of key #1 in finger zone #2 (empty: no zone)
\def\omkb@fillfor#1#2{%
  \def\omkb@fill{white}%
  \ifomkb@fingers\ifx\relax#2\relax\else\edef\omkb@fill{\csname omkb@zc@#2\endcsname}\fi\fi
  \omkb@hitfalse\def\omkb@test{#1}%
  \@for\omkb@x:=\omkb@hl\do{\ifx\omkb@x\omkb@test\omkb@hittrue\fi}%
  \def\omkb@line{black!60}\def\omkb@lw{0.4pt}%
  \ifomkb@hit\def\omkb@line{ocInk}\def\omkb@lw{1.3pt}\ifomkb@fingers\else\def\omkb@fill{omkbH}\fi\fi}
% \omkb@key{name}{x}{row}{width}{zone}{word on the key, or empty for the layout's legend}
\def\omkb@key#1#2#3#4#5#6{%
  \omkb@fillfor{#1}{#5}%
  \node[draw=\omkb@line, line width=\omkb@lw, rounded corners=1.5pt, fill=\omkb@fill, inner sep=0,
    minimum width=#4*\omkb@u-0.1*\omkb@u, minimum height=0.9*\omkb@u] (kb-#1) at ({#2+#4/2},{-#3-0.5}) {};%
  \ifomkb@nolegend\else
    \def\omkb@cur{#1}%
    \ifx\relax#6\relax
      \ifcsname omkb@l@\omkb@lay @#1\endcsname\csname omkb@l@\omkb@lay @#1\endcsname\fi
    \else
      \node[font=\sffamily\tiny, inner sep=0, align=center] at (kb-#1.center) {#6};%
    \fi
  \fi}
\def\omkb@draw#1{%
  \def\omkb@lay{#1}%
  \edef\omkb@iso{\csname omkb@iso@#1\endcsname}%
  % row 0
  \omkb@key{TLDE}{0}{0}{1}{P}{}%
  \foreach \i/\z in {1/P,2/R,3/M,4/I,5/I,6/J,7/J,8/N,9/S,10/Q,11/Q,12/Q}{%
    \edef\omkb@n{AE\ifnum\i<10 0\fi\i}\expandafter\omkb@key\expandafter{\omkb@n}{\i}{0}{1}{\z}{}}%
  \omkb@key{BKSP}{13}{0}{2}{Q}{\omkbBksp}%
  % row 1
  \omkb@key{TAB}{0}{1}{1.5}{P}{\omkbTab}%
  \foreach \i/\z in {1/P,2/R,3/M,4/I,5/I,6/J,7/J,8/N,9/S,10/Q,11/Q,12/Q}{%
    \edef\omkb@n{AD\ifnum\i<10 0\fi\i}\pgfmathsetmacro\omkb@xx{\i+0.5}%
    \expandafter\omkb@key\expandafter{\omkb@n}{\omkb@xx}{1}{1}{\z}{}}%
  % row 2
  \omkb@key{CAPS}{0}{2}{1.75}{P}{\omkbCaps}%
  \foreach \i/\z in {1/P,2/R,3/M,4/I,5/I,6/J,7/J,8/N,9/S,10/Q,11/Q}{%
    \edef\omkb@n{AC\ifnum\i<10 0\fi\i}\pgfmathsetmacro\omkb@xx{\i+0.75}%
    \expandafter\omkb@key\expandafter{\omkb@n}{\omkb@xx}{2}{1}{\z}{}}%
  \ifnum\omkb@iso=1
    \omkb@key{BKSL}{12.75}{2}{1}{Q}{}%
    \omkb@fillfor{RTRN}{Q}%
    \draw[\omkb@line, line width=\omkb@lw, rounded corners=1.5pt, fill=\omkb@fill] (13.55,-1.05) -- (14.95,-1.05) -- (14.95,-2.95)
      -- (13.8,-2.95) -- (13.8,-1.95) -- (13.55,-1.95) -- cycle;%
    \coordinate (kb-RTRN) at (14.375,-1.5);%
    \ifomkb@nolegend\else\node[font=\sffamily\tiny, inner sep=0] at (kb-RTRN) {\omkbEnter};\fi
  \else
    \omkb@key{BKSL}{13.5}{1}{1.5}{Q}{}%
    \omkb@key{RTRN}{12.75}{2}{2.25}{Q}{\omkbEnter}%
  \fi
  % row 3
  \ifnum\omkb@iso=1
    \omkb@key{LFSH}{0}{3}{1.25}{P}{\omkbShift}%
    \omkb@key{LSGT}{1.25}{3}{1}{P}{}%
  \else
    \omkb@key{LFSH}{0}{3}{2.25}{P}{\omkbShift}%
  \fi
  \foreach \i/\z in {1/P,2/R,3/M,4/I,5/I,6/J,7/J,8/N,9/S,10/Q}{%
    \edef\omkb@n{AB\ifnum\i<10 0\fi\i}\pgfmathsetmacro\omkb@xx{\i+1.25}%
    \expandafter\omkb@key\expandafter{\omkb@n}{\omkb@xx}{3}{1}{\z}{}}%
  \omkb@key{RTSH}{12.25}{3}{2.75}{Q}{\omkbShift}%
  % row 4
  \omkb@key{LCTL}{0}{4}{1.25}{}{\omkbCtrl}%
  \omkb@key{LWIN}{1.25}{4}{1.25}{}{\relax}%
  \omkb@key{LALT}{2.5}{4}{1.25}{}{\omkbAlt}%
  \omkb@key{SPCE}{3.75}{4}{6.25}{T}{\relax}%
  \ifnum\omkb@iso=1 \omkb@key{RALT}{10}{4}{1.25}{}{\omkbAltGr}%
  \else \omkb@key{RALT}{10}{4}{1.25}{}{\omkbAlt}\fi
  \omkb@key{RWIN}{11.25}{4}{1.25}{}{\relax}%
  \omkb@key{MENU}{12.5}{4}{1.25}{}{\relax}%
  \omkb@key{RCTL}{13.75}{4}{1.25}{}{\omkbCtrl}%
  \ifomkb@home
    \draw[line width=0.9pt, black!70] ([xshift=-1.6mm, yshift=1.6mm]kb-AC04.south) -- ([xshift=1.6mm, yshift=1.6mm]kb-AC04.south);
    \draw[line width=0.9pt, black!70] ([xshift=-1.6mm, yshift=1.6mm]kb-AC07.south) -- ([xshift=1.6mm, yshift=1.6mm]kb-AC07.south);
  \fi}
